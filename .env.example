# 실제 값은 .env.local(gitignore)에 두세요. 이 파일은 필요한 키만 문서화합니다.

# 서버 API base URL (예: https://api.link-ding-dong.com/api/v1)
EXPO_PUBLIC_API_BASE_URL=

# 로그인 연동 전 임시 인증 마스터 토큰(Bearer, 서버 MASTER_ACCESS_TOKEN 과 동일).
# 폴더 API 등 인증 필요 엔드포인트 실호출용. 정식 로그인 구현(#auth) 시 제거 예정.
#
# ⚠️ 로컬 개발 전용 — 배포/CI 환경에는 절대 설정하지 마세요.
# EXPO_PUBLIC_ 접두사 값은 빌드 타임에 JS 번들로 인라인되므로, 이 값이 설정된 채
# `pnpm deploy` 를 돌리면 마스터 토큰이 공개 웹 번들에 그대로 실립니다.
# (deploy/preview 는 scripts/assert-no-master-token.mjs 가 이를 검사해 빌드를 막습니다.)
EXPO_PUBLIC_API_MASTER_TOKEN=

# Google OAuth (@react-native-google-signin) — 네이티브 idToken 발급용, 웹 GIS 도 Web 클라이언트를 재사용한다.
# Google Cloud Console 에서 팀 프로젝트 기준으로 iOS·Android·Web 클라이언트 3종을 발급해 채운다.
# webClientId: GoogleSignin.configure() 의 idToken 발급 대상(audience). iOS/Android/Web 공통.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS 전용 클라이언트 ID. Firebase 미사용이라 GoogleSignin.configure() 에 명시적으로 넘겨야 한다.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android 클라이언트 ID는 코드에서 참조하지 않는다 — Google Cloud Console 에
# package name(com.mashup.promise9) + 디버그/릴리즈 키스토어 SHA-1 로만 등록하면 매칭된다.
#
# ⚠️ client secret(GOCSPX-...)은 절대 여기 넣지 않는다 — 이 SDK·웹 GIS 는 공개 클라이언트
# 플로우라 client ID만 있으면 되고, secret 은 Cloud Console 에만 보관한다.

# 카카오 웹 로그인 authorize 의 client_id(카카오 REST API 키). 웹 전용 —
# 네이티브는 app.json 의 kakaoAppKey(네이티브 앱키)를 쓴다.
# ⚠️ client_secret 은 절대 넣지 않는다 — 서버 /auth/kakao/exchange 가 보관한다.
EXPO_PUBLIC_KAKAO_REST_API_KEY=
