# 실제 값은 .env.local(gitignore)에 두세요. 이 파일은 필요한 키만 문서화합니다.

# 서버 API base URL (예: https://api.link-ding-dong.com/api/v1)
EXPO_PUBLIC_API_BASE_URL=

# 로그인 연동 전 임시 인증 마스터 토큰(Bearer, 서버 MASTER_ACCESS_TOKEN 과 동일).
# 폴더 API 등 인증 필요 엔드포인트 실호출용. 정식 로그인 구현(#auth) 시 제거 예정.
#
# ⚠️ 로컬 개발 전용 — 배포/CI 환경에는 절대 설정하지 마세요.
# EXPO_PUBLIC_ 접두사 값은 빌드 타임에 JS 번들로 인라인되므로, 이 값이 설정된 채
# `pnpm deploy` 를 돌리면 마스터 토큰이 공개 웹 번들에 그대로 실립니다.
# (deploy/preview 는 scripts/assert-no-master-token.mjs 가 이를 검사해 빌드를 막습니다.)
EXPO_PUBLIC_API_MASTER_TOKEN=
