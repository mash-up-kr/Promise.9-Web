# 실제 값은 extension/.env.local(gitignore)에 두세요. 이 파일은 필요한 키만 문서화합니다.

# 서버 API base URL (예: https://api.link-ding-dong.com/api/v1)
# 루트 .env.local 의 EXPO_PUBLIC_API_BASE_URL 과 같은 값을 씁니다.
VITE_API_BASE_URL=

# 구글 OAuth 웹 클라이언트 ID (루트 .env.local 의 EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID 와 같은 값).
#
# ⚠️ 이 값만으로는 로그인이 통과하지 않습니다. Google Cloud Console 의 해당 웹 클라이언트
# "승인된 리디렉션 URI" 에 확장의 리다이렉트 주소를 등록해야 합니다:
#   https://<확장 ID>.chromiumapp.org/
# 확장 ID 는 chrome://extensions 에서 확인하거나, 확장 콘솔에서
#   chrome.identity.getRedirectURL()
# 을 실행해 그대로 복사하면 됩니다. (client secret 은 넣지 않습니다 — implicit 흐름입니다.)
VITE_GOOGLE_WEB_CLIENT_ID=

# 저장 성공 후 '링크 보러가기' 가 여는 웹앱 주소.
# 비워두면 배포 주소(https://link-ding-dong.com)를 쓴다 — 스테이징을 볼 때만 설정하세요.
VITE_WEB_APP_BASE_URL=
