# 실제 값은 extension/.env.local(gitignore)에 두세요. 이 파일은 필요한 키만 문서화합니다.

# 서버 API base URL (예: https://api.link-ding-dong.com/api/v1)
# 루트 .env.local 의 EXPO_PUBLIC_API_BASE_URL 과 같은 값을 씁니다.
VITE_API_BASE_URL=

# 로그인 연동 전 임시 인증 마스터 토큰(Bearer, 서버 MASTER_ACCESS_TOKEN 과 동일).
# ⚠️ 로컬 개발 전용 — 스토어 배포용 빌드에는 절대 설정하지 마세요.
# VITE_* 값은 빌드 타임에 번들로 인라인되므로, 설정한 채 빌드하면 토큰이 그대로 실립니다.
VITE_API_MASTER_TOKEN=

# 저장 성공 후 '링크 보러가기' 가 여는 웹앱 주소.
# 비워두면 배포 주소(https://link-ding-dong.com)를 쓴다 — 스테이징을 볼 때만 설정하세요.
VITE_WEB_APP_BASE_URL=
