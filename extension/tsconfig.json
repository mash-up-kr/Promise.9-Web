{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // vite.config.ts 가 manifest.config.ts 를 확장자까지 써서 import 한다(Vite 권장).
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "types": ["chrome", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      "@assets/*": ["../assets/*"]
    }
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "vite.rnw.ts",
    "manifest.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "../packages/ui"
  ],
  // 패키지 테스트는 jest-expo + RNTL 용이다 — 루트 tsc 가 검사한다.
  "exclude": ["../packages/ui/**/*.test.ts", "../packages/ui/**/*.test.tsx"]
}
