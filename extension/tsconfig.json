{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // vite.config.ts 가 manifest.config.ts 를 확장자까지 써서 import 한다(Vite 권장).
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "types": ["chrome", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      "@assets/*": ["../assets/*"]
    }
  },
  "include": ["src", "vite.config.ts", "manifest.config.ts", "vitest.setup.ts"]
}
