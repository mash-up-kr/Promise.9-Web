# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env 도 무시한다 — Expo 는 이 파일도 읽으므로 여기에 토큰을 넣으면 그대로 커밋된다.
.env
.env*.local

# typescript
*.tsbuildinfo

example

# Claude Code local settings
.claude/settings.local.json

# 로컬 에이전트 도구 설정 (개인용, 커밋·EAS 업로드 대상 아님)
.agents/
.codex/

# generated native folders
/ios
/android

# Git worktrees
.worktrees/

# eas metadata:pull 산출물 — 동적 설정(store.config.js)은 갱신하지 못하고 JSON·스크린샷 사본을 새로 만든다
store.config.json
/store/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# Playwright (web E2E)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Local planning docs (never committed)
plan/
_workspace/

# 로컬 expo 모듈의 gradle 산출물
modules/*/android/build/
