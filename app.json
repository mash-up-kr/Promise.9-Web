{
  "expo": {
    "name": "Promise9 Web",
    "slug": "promise9-web",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "promise9web",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.mashup.promise9",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "링띵동"
      }
    },
    "android": {
      "package": "com.mashup.promise9",
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidShareActivity",
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "type": "url",
              "max": 1
            }
          ],
          "height": 600,
          "backgroundColor": {
            "red": 0,
            "green": 0,
            "blue": 0,
            "alpha": 0
          }
        }
      ],
      [
        "./plugins/withShareExtensionDisplayName",
        {
          "displayName": "링띵동"
        }
      ],
      "./plugins/withShareExtensionAuthUrlSchemes",
      [
        "./plugins/withAndroidAppLabel",
        {
          "label": "링띵동"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a1a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.507681878750-lkjpcaa1iub4uqv603nh8n8bj3minp2s"
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "d0957b9703accce469748d981d81f796"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
